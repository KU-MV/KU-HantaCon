FROM mambaorg/micromamba:1.5.8

# 작업 디렉토리
WORKDIR /workspace

# 🔹 환경 변수 선언
ENV HOME=/workspace
ENV MAMBA_ROOT_PREFIX=/opt/conda

# env.yml 복사 및 환경 생성
COPY env.yml /tmp/env.yml
RUN micromamba create -y -n HantaCon -f /tmp/env.yml && \
    micromamba run -n HantaCon pip install --no-cache-dir "setuptools<66" && \
    micromamba clean --all --yes

# 스크립트와 reference 복사
COPY scripts/ /opt/hantacon/scripts/

# 기본 쉘
SHELL ["/bin/bash", "-lc"]